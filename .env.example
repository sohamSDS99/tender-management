# ---------------------------------------------------------------------------
# Copy to .env and adjust:  cp .env.example .env
#
# Every value below has a working default except the three secrets at the top,
# which the system degrades around rather than crashing on:
#   - no SLACK_WEBHOOK_URL  -> tenders are still ingested and scored, the
#                              dashboard says notifications are off
#   - no CRON_SECRET        -> the write endpoints refuse (503) instead of being
#                              left open
#   - no SAM_GOV_API_KEY    -> SAM.gov falls back to its keyless bulk extract
#   - no HIGHERGOV_API_KEY  -> 8 of 9 sources run, HigherGov reports why it is off
#     or HIGHERGOV_SEARCH_ID
#
# .env is gitignored. Nothing in this file is ever logged: see
# app/settings/config.py redact().
# ---------------------------------------------------------------------------

# --- notifications ---------------------------------------------------------
# Slack incoming webhook. Create at https://api.slack.com/apps -> your app ->
# "Incoming Webhooks" -> "Add New Webhook to Workspace" -> pick the channel.
# Free, no app review, no bot token. Format:
#   https://hooks.slack.com/services/T00000000/B00000000/xxxxxxxxxxxxxxxxxxxxxxxx
SLACK_WEBHOOK_URL=

# --- or --- the bot-token transport, which is preferred when both are set.
#
# A bot token is revocable; an incoming webhook URL *is* its own credential and
# cannot be rotated without re-issuing it. Which transport is in force is derived
# from what is set here, never configured separately - see docs/DECISIONS.md (D22).
#
# Scopes required on the Slack app: chat:write, plus chat:write.public to post to
# a public channel the bot has not joined, plus chat:write.customize for
# SLACK_BOT_USERNAME / SLACK_BOT_ICON_EMOJI below.
#
# Secret. Bot User OAuth Token from the app's "OAuth & Permissions" page.
SLACK_BOT_TOKEN=
# Channel ID, not a name: C0123ABCDEF. Find it with
#   curl -s "https://slack.com/api/conversations.list?types=public_channel,private_channel" \
#     -H "Authorization: Bearer $SLACK_BOT_TOKEN"
# A name would break the day someone renames the channel.
SLACK_CHANNEL_ID=

# The name a digest arrives under. Worth setting: a Slack app is often created for
# something else, and its bot user is named accordingly. Needs chat:write.customize.
SLACK_BOT_USERNAME=Tender Monitor
SLACK_BOT_ICON_EMOJI=:satellite_antenna:

# Announce a new tender only at or above this score. 70 is the README's
# "highly relevant" band. A tender must also be newly created by that run and
# is_actionable - see app/services/notifier.py.
SLACK_MIN_SCORE=70

# Shown in the digest so a reader knows which channel they are looking at, and
# used as the ledger key (D6): changing it makes every tender inside the lookback
# window eligible to be announced once more, under the new label. Right when the
# destination channel really changes; wrong when the channel is merely renamed.
SLACK_CHANNEL_LABEL=#tenders

# Set false to ingest and score without posting anything.
ENABLE_SLACK_NOTIFICATIONS=true

# Most items in one digest before it becomes "+N more" (hard-capped at 11 so the
# payload can never exceed Slack's 50-block limit).
SLACK_MAX_ITEMS=8

# How long to wait for the webhook before treating the post as failed.
SLACK_TIMEOUT_SECONDS=15

# A 'pending' claim older than this is treated as abandoned (a process died
# mid-post) and may be retried. Only a 'sent' claim suppresses forever, so a
# crash cannot silence a tender permanently.
SLACK_CLAIM_STALE_MINUTES=30

# --- translation -----------------------------------------------------------
# A notice not in English gets a Translate button in the detail panel (D33).
# Which implementation performs it. Two keyless options, and the choice is not
# about quality alone:
#   mymemory    - the DEFAULT, and the only one that works from a datacenter.
#                 Caps a request at 500 characters. Free allowance is 5,000
#                 characters a day per IP, or 50,000 with TRANSLATION_CONTACT_EMAIL.
#   google_free - better English on run-on legal prose, 8,000 characters a
#                 request, but answers 429 to Railway's egress IP whatever
#                 headers are sent. Use it on a laptop or the LAN deployment.
# A keyed provider is a new entry in translator._PROVIDERS and a change here —
# no call site moves. Every translation is cached per notice, so the provider is
# asked once per foreign notice a human actually opens, ever.
TRANSLATION_PROVIDER=mymemory

# Not a credential — an ordinary contact address. MyMemory raises the keyless
# daily allowance from 5,000 characters to 50,000 when one is supplied. Leave
# empty and it is omitted from the request rather than sent blank.
TRANSLATION_CONTACT_EMAIL=

# Per request, not per notice: a longer description is split on sentence
# boundaries and reassembled. Capped further by the provider's own limit, so
# raising this above 500 does nothing while TRANSLATION_PROVIDER=mymemory.
TRANSLATION_MAX_CHUNK_CHARS=4000
TRANSLATION_TIMEOUT_SECONDS=20

# --- public surfaces -------------------------------------------------------
# Base URL of the dashboard. Every Slack entry deep-links to
# {PUBLIC_APP_URL}/?tender=<id>, so this must be reachable by whoever clicks it.
# localhost is fine when the reader is on the machine running the app; put a
# LAN address or tunnel here if colleagues need the links to work.
PUBLIC_APP_URL=http://localhost:8080

# Host ports for docker-compose. Change these if something else on the machine
# already listens there, and keep PUBLIC_APP_URL in step with WEB_PORT.
WEB_PORT=8080
API_PORT=8000

# Shared secret for the operator/CI-only write endpoints (POST /api/fetch,
# POST /api/tenders/rescore). Empty means those endpoints are refused outright.
# Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
CRON_SECRET=

# Serve /docs and /openapi.json. Fine on a local host; set false before the API
# is ever reachable from the internet (README section 12).
ENABLE_API_DOCS=true

# --- operator actions from the dashboard (D23) -----------------------------
# "Fetch new tenders" and "Re-score" are callable from the browser without a
# secret. What stops them being abused is not authentication but cost control:
# one sweep at a time, and a minimum gap between operator-started runs. A caller
# presenting CRON_SECRET bypasses both, because CI controls its own timing.
#
# Set false to close both to the browser again (403). This MUST be false before
# the API is ever reachable from the internet.
ALLOW_OPERATOR_ACTIONS=true

# Minimum gap between operator-started sweeps, and between re-scores. A full
# sweep queries eight public services; a re-score rewrites every stored row.
OPERATOR_FETCH_COOLDOWN_SECONDS=300
OPERATOR_RESCORE_COOLDOWN_SECONDS=120

# How far back a sweep started from the dashboard looks, in days.
#
# Deliberately far deeper than FETCH_MIN_LOOKBACK_HOURS below, and the reason is
# the whole point of the setting. The schedule's 72-hour overlap exists to keep
# up with the present; a human pressing "Fetch new tenders" is asking the
# opposite question - go and look further back than the schedule does. Handing
# the button the schedule's own window meant it re-queried a window the last
# cron run had already emptied, so it truthfully reported success and created
# almost nothing, which read as "fetching is broken". Measured at one instant on
# the same five connectors: 34 notices returned over 72 hours, 119 over 30 days.
#
# The dashboard shows this value on the button and lets the reader pick another
# depth per sweep. Raising it costs time, not correctness: every write is an
# upsert keyed on (source, notice id). See docs/DECISIONS.md (D24).
OPERATOR_FETCH_DAYS_BACK=30

# --- scheduling ------------------------------------------------------------
# Off by default so no process fetches unexpectedly. Exactly ONE trigger owner
# may be enabled: either this in-process scheduler (what docker-compose uses) or
# the GitHub Actions workflow writing to the same database - never both, or the
# same window is fetched twice. See docs/DECISIONS.md (D2).
#
# This is only the DEFAULT. Sweeps can be paused and resumed from the dashboard
# without a restart, and that stored decision wins over this value from then on -
# so if sweeps are not running, check the dashboard before this file.
# See docs/DECISIONS.md (D21) and docs/RUNBOOK.md section 5c.
ENABLE_SCHEDULER=false

# Local run times, in SCHEDULER_TIMEZONE. 00:00 and 12:00 Asia/Dhaka, which is
# cron '0 18 * * *' and '0 6 * * *' in UTC. The conversion is computed in
# app/jobs/schedule.py and asserted in tests - never hardcode the offset.
#
# This is only the DEFAULT. Anyone can change the sweep times from the dashboard
# (Sweep times and source health -> Sweep times), which stores them in the
# database and applies them to the running scheduler without a restart. Once set
# there, this variable is ignored until the stored value is reset.
# See docs/DECISIONS.md D19.
SCHEDULER_TIMEZONE=Asia/Dhaka
SCHEDULER_HOURS_LOCAL=0,12

# --- storage ---------------------------------------------------------------
# SQLite by default (no server needed). docker-compose overrides this with
# PostgreSQL, which is what a real deployment should use. Both are migrated by
# the same Alembic revisions and both are verified in CI.
#   DATABASE_URL=postgresql+psycopg://tender:tender@localhost:5432/tenders
DATABASE_URL=sqlite:///./data/tenders.db
RUN_MIGRATIONS_ON_STARTUP=true

# --- credentials -----------------------------------------------------------
# Free personal key from https://sam.gov/content/api-keys (US SAM.gov only).
# Leave empty to disable that one connector gracefully.
SAM_GOV_API_KEY=
# SAM.gov meters Get Opportunities per day: 10 requests on a non-federal account
# with no role, 1000 with one. The defaults below keep a sweep to a single
# request; raise them (20 / 60) only if the account holds a role.
SAM_MAX_PAGES=1
SAM_MAX_DESCRIPTION_FETCHES=0
# The default transport is the free daily bulk extract: no key, no quota, and it
# carries descriptions inline. Set false to use the metered API instead (which
# is the only way to query a window in the past, or to see closed notices).
SAM_USE_BULK_EXTRACT=true
# HigherGov (US federal + state/local aggregator). An account admin creates the
# key from the gear icon -> API at https://www.highergov.com.
HIGHERGOV_API_KEY=
# REQUIRED alongside the key, and the unusual part of this source: the HigherGov
# API has no free-text search on any endpoint, and *silently ignores* unknown
# parameters - a keyword parameter returns HTTP 200 and the unfiltered feed. The
# only server-side filter is a saved search built in the web UI: create one
# (Keywords, and optionally NAICS/PSC/Set Aside/Value Range), then copy the
# `searchID=` value out of that page's URL into here.
#
# With this empty the connector refuses to run rather than degrade. That is
# deliberate: base usage is 10,000 records/month, a single day of postings is
# ~5,500 records, and of 300 sampled from the unfiltered feed *none* reached the
# 50-point relevance band. Prefer strong, product-specific phrases ("sds
# management", "ehs software") over bare terms ("safety data sheet"), which
# match every chemical purchase order in government.
HIGHERGOV_SEARCH_ID=
# Guard against a very broad saved search, not a tuning knob. A capped sweep is
# logged as truncated rather than passing for full coverage.
HIGHERGOV_MAX_PAGES=5

# --- fetch windows ---------------------------------------------------------
FETCH_LOOKBACK_DAYS=3
FETCH_MIN_LOOKBACK_HOURS=72
# Only used by the legacy interval trigger; the cron schedule above supersedes it.
FETCH_INTERVAL_HOURS=6

# --- HTTP behaviour --------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=1.0
MAX_RESPONSE_BYTES=30000000
MAX_PAGES_PER_SOURCE=20
PAGE_SIZE=100

# CanadaBuys and AusTender sit behind WAFs that reject non-browser-shaped user
# agents. This form identifies the tool and is accepted by every source.
USER_AGENT=Mozilla/5.0 (compatible; tender-monitor/0.1)

# --- app -------------------------------------------------------------------
# Only needed when the browser and the API are on different origins. The
# docker-compose setup serves both from http://localhost:8080, so this is for
# `npm run dev` against a separately started API.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080
LOG_LEVEL=INFO
RELEVANCE_CONFIG_PATH=./config/relevance_profiles.yaml

# --- per-source switches ---------------------------------------------------
ENABLE_TED=true
ENABLE_SAM=true
ENABLE_FIND_A_TENDER=true
ENABLE_CONTRACTS_FINDER=true
ENABLE_WORLD_BANK=true
ENABLE_CANADA_BUYS=true
ENABLE_AUSTENDER=true
ENABLE_PNCP=true
ENABLE_HIGHERGOV=true

# Sources without server-side keyword search (UK feeds, CanadaBuys, AusTender,
# PNCP) are prefiltered on topical terms before storage. Set false to store
# every notice in the window (much larger database).
APPLY_KEYWORD_PREFILTER=true

# --- source tuning ---------------------------------------------------------
ENABLE_CANADA_BUYS_OPEN_FEED=true
PNCP_MODALIDADES=6,8,4,5
PNCP_MAX_PAGES=6

# --- accounts (D25) ---------------------------------------------------------
# Reading tenders needs no account and never has. An account adds a profile,
# and lets an administrator invite people. The FIRST registration on a fresh
# deployment becomes the administrator and needs no invite, so register
# immediately after the first start — see docs/RUNBOOK.md.

# Send the session cookie only over HTTPS. MUST stay false for a plain-HTTP
# deployment (the documented LAN one): a Secure cookie over HTTP is silently
# never sent, and the symptom is a sign-in that returns 200 and leaves you
# signed out. Set it true the moment the dashboard is served over TLS.
SESSION_COOKIE_SECURE=false

# How long a signed-in browser stays signed in. Sliding: touched at most once
# an hour, and extended when it is.
SESSION_LIFETIME_DAYS=14

# How long an invitation link stays usable. Single-use regardless.
INVITE_LIFETIME_DAYS=7

# Minimum password length. Length is the only rule — composition rules push
# people towards Password1!.
PASSWORD_MIN_LENGTH=10

# Per-account lockout, not per-address: the API is behind a proxy, so every
# browser on the network would otherwise share one bucket.
LOGIN_MAX_FAILURES=8
LOGIN_LOCKOUT_MINUTES=15

# Require a session for every route except /health and the /api/auth doors
# (D26). This is what closes the dashboard to people without an account.
#
# Set false ONLY to get back into a deployment whose gate is misbehaving — it
# restores the pre-D26 behaviour, where every read answered anybody.
REQUIRE_SIGN_IN=true

# One address that cannot be demoted, deactivated, or moved off itself (D32).
#
# Empty by default, which is exactly the behaviour that existed before it: the
# only protection is then the last-administrator guard, so with three admins any
# of them can deactivate any other. Naming an address makes that one account a
# fixed point regardless of how many administrators exist.
#
# A deployment variable and not a database column on purpose: an account nobody
# can remove is also an account nobody can revoke if it is ever compromised, so
# the protection has to be liftable faster than a deploy. Clear this and the
# guard is gone on the next request.
#
# It protects a role, it does not grant one — naming a member here does not make
# them an administrator.
PLATFORM_ADMIN_EMAIL=

# --- translation (D33, D35) ------------------------------------------------
# The Translate button. "deepl" is the default and needs a key; it is the only
# option with no per-IP ration. The keyless alternatives still work and need no
# key, at the cost of a daily allowance:
#   mymemory     5,000 chars/day per IP (50,000 with TRANSLATION_CONTACT_EMAIL)
#   google_free  better English, but answers 429 from Railway's egress IP
TRANSLATION_PROVIDER=deepl
# Secret. From https://www.deepl.com/your-account/keys — a key ending in ":fx"
# is a free account and is routed to api-free.deepl.com automatically.
DEEPL_API_KEY=
# Only read by the mymemory provider. Not a credential, just a contact address:
# it lifts that provider's keyless allowance from 5,000 to 50,000 chars/day.
TRANSLATION_CONTACT_EMAIL=
