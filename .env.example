# ---------------------------------------------------------------------------
# Copy to .env and adjust. Every value below is optional: the defaults run the
# whole application on SQLite with no credentials.
# ---------------------------------------------------------------------------

# Storage. SQLite by default; PostgreSQL works unchanged, e.g.
# DATABASE_URL=postgresql+psycopg://tender:tender@localhost:5432/tenders
DATABASE_URL=sqlite:///./data/tenders.db

# Free personal key from https://sam.gov/content/api-keys (US SAM.gov only).
# Leave empty to disable the SAM.gov connector gracefully.
SAM_GOV_API_KEY=

# Scheduling and fetch windows
FETCH_INTERVAL_HOURS=6
FETCH_LOOKBACK_DAYS=3
FETCH_MIN_LOOKBACK_HOURS=72
ENABLE_SCHEDULER=true

# HTTP behaviour
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=1.0
MAX_RESPONSE_BYTES=30000000
MAX_PAGES_PER_SOURCE=20
PAGE_SIZE=100

# App
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080
LOG_LEVEL=INFO
RELEVANCE_CONFIG_PATH=./config/relevance_profiles.yaml
RUN_MIGRATIONS_ON_STARTUP=true

# ---------------------------------------------------------------------------
# Per-source switches
# ---------------------------------------------------------------------------
ENABLE_TED=true
ENABLE_SAM=true
ENABLE_FIND_A_TENDER=true
ENABLE_CONTRACTS_FINDER=true
ENABLE_WORLD_BANK=true
ENABLE_CANADA_BUYS=true
ENABLE_AUSTENDER=true
ENABLE_PNCP=true

# Sources without server-side keyword search (UK feeds, CanadaBuys, AusTender,
# PNCP) are prefiltered on topical terms before storage. Set to false to store
# every notice in the window (much larger database).
APPLY_KEYWORD_PREFILTER=true

# Source tuning
ENABLE_CANADA_BUYS_OPEN_FEED=true
PNCP_MODALIDADES=6,8,4,5
PNCP_MAX_PAGES=6
